PORT=4000
FRONTEND_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/fabbazaar
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
RAZORPAY_KEY_ID=replace-with-rzp_test_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-secret
